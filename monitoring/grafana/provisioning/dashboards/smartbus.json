{
  "title": "SmartBus service health",
  "uid": "smartbus-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id":1,"type":"timeseries","title":"Backend request rate","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[5m])) by (uri)","legendFormat":"{{uri}}"}]},
    {"id":2,"type":"timeseries","title":"Backend 5xx responses","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))","legendFormat":"5xx / sec"}]},
    {"id":3,"type":"timeseries","title":"JVM memory used","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum(jvm_memory_used_bytes)","legendFormat":"bytes"}]},
    {"id":4,"type":"timeseries","title":"Database connection pool","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"hikaricp_connections_active","legendFormat":"active"},{"expr":"hikaricp_connections_pending","legendFormat":"pending"}]}
  ]
}
