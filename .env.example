# Copy to .env and fill in. NEVER commit .env.
DB_NAME=smartbus
DB_USER=smartbus
DB_PASSWORD=change-me-db-password
# at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# first administrator account, created by the backend on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# URL the browser uses for the app (only used for CORS in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
